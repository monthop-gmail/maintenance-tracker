{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // หน้าเว็บ (ไฟล์ใน public/) เสิร์ฟตรงจาก Workers Static Assets
  // ส่วน /api/* ให้ Worker จัดการก่อนเสมอ
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id ใน repo เป็นค่าว่าง (0000...) — ตอน deploy:
  // - GitHub Actions ของ repo นี้จะหา/สร้างฐานข้อมูลชื่อ maintenance-tracker แล้วใส่ id ให้เอง
  // - ปุ่ม "Deploy to Cloudflare" จะสร้างฐานข้อมูลและแก้ค่านี้ใน repo ของผู้ใช้เอง
  // - deploy เองด้วย wrangler: `npx wrangler d1 create maintenance-tracker` แล้วเอา id มาใส่แทน
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maintenance-tracker",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ทุกชั่วโมง: ส่งสรุปงานดูแลที่ใกล้/เลยกำหนด ตามเวลาที่ตั้งไว้ (ทำงานเฉพาะเมื่อมีเครื่องเปิดรับการแจ้งเตือน)
  "triggers": { "crons": ["0 * * * *"] },

  "observability": { "enabled": true }

  // Secrets (ตั้งด้วย npx wrangler secret put <NAME>):
  //   APP_PASSWORD  — รหัสผ่านเข้าแอป อย่างน้อย 8 ตัว (จำเป็น)
  //   API_TOKEN     — token สำหรับบันทึกผ่าน API/Shortcuts (ไม่บังคับ)
}
